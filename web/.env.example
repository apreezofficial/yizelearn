# The yizelearn API base URL, e.g. https://api.yizelearn.com/v1
NEXT_PUBLIC_API_URL=

# OPTIONAL. Without it the site translates with Google's free Website Translator in the visitor's browser.
# With it, pages are translated by the Google Cloud Translation API through /api/translate (more control, billed by Google).
# Server-side only: never expose this key to the browser.
GOOGLE_TRANSLATE_API_KEY=
