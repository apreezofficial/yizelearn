# The yizelearn backend (no trailing slash, no /v1). Server-side only; the browser reaches it through the /yz proxy.
API_URL=https://16-170-53-222.sslip.io
# OPTIONAL. Without it the site translates with Google's free Website Translator in the visitor's browser.
# With it, pages are translated by the Google Cloud Translation API through /api/translate (more control, billed by Google).
# Server-side only: never expose this key to the browser.
GOOGLE_TRANSLATE_API_KEY=

# Preferred public canonical domain (https://..., no trailing slash).
# On Vercel, defaults to VERCEL_PROJECT_PRODUCTION_URL when SITE_URL is not set.
SITE_URL=https://yizelearn.com
